{
  "info": {
    "name": "TaskFlow API",
    "description": "Week 2 bare node:http API. Start the server (npm run dev), then run the whole collection in order: later requests use ids saved by earlier ones.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
